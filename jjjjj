const HEIGHT=18.8;
const LIGHT=3;

function makeMatrix(m){
 const origin=C.Cartesian3.fromDegrees(
  BASE_LON,BASE_LAT,0
 );

 const enu=C.Transforms.eastNorthUpToFixedFrame(origin);

 const local=new C.Cartesian3(
  m.east,m.north,0
 );

 const world=C.Matrix4.multiplyByPoint(
  enu,local,new C.Cartesian3()
 );

 const carto=C.Cartographic.fromCartesian(world);
 let terrain=scene.globe.getHeight(carto);
 if(!Number.isFinite(terrain))terrain=0;

 const position=C.Cartesian3.fromRadians(
  carto.longitude,
  carto.latitude,
  terrain+HEIGHT
 );

 const hpr=new C.HeadingPitchRoll(
  C.Math.toRadians(m.rz),
  C.Math.toRadians(m.rx),
  C.Math.toRadians(m.ry)
 );

 return C.Transforms.headingPitchRollToFixedFrame(
  position,hpr,C.Ellipsoid.WGS84,
  C.Transforms.eastNorthUpToFixedFrame
 );
}

window.__osakaGLBPlacement?.destroy?.();

const added=[];

const manager={
 destroy(){
  added.forEach(model=>{
   try{scene.primitives.remove(model);}catch(e){}
  });
  added.length=0;
 }
};

window.__osakaGLBPlacement=manager;

models.forEach(m=>{
 const url=BASE+m.file;

 try{
  const model=C.Model.fromGltf({
   url,
   modelMatrix:makeMatrix(m),
   scale:m.scale,
   allowPicking:true,
   incrementallyLoadTextures:true
  });

  scene.primitives.add(model);
  added.push(model);

  const ready=model.readyPromise;
  if(ready&&typeof ready.then==="function"){
   ready.then(()=>{
    model.color=new C.Color(
     LIGHT,LIGHT,LIGHT,1
    );
    model.imageBasedLightingFactor=
     new C.Cartesian2(m.diffuse,m.specular);

    console.log("[OSAKA] Loaded:",m.file);
   }).catch(error=>{
    console.error("[OSAKA] Failed:",m.file,error);
   });
  }
 }catch(error){
  console.error("[OSAKA] Error:",m.file,error);
 }
});

console.log(
 "[OSAKA] GLB placement started:",
 models.length,"models",
 "height:",HEIGHT,
 "Z rotation: 180",
 "light:",LIGHT
);
})();