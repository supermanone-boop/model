const viewer=g.api.viewer;
const scene=viewer.scene;

const BASE=
 "https://huggingface.co/supermanone-boop/OSAKA/resolve/main/";

const BASE_LON=135.4953509;
const BASE_LAT=34.7022887;

const models=[
 {
