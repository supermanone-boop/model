try{
const p=viewer.terrainProvider?.readyPromise;
if(p)await Promise.race([p.catch(()=>{}),new Promise(r=>setTimeout(r,8000))]);
}catch(e){}
await new Promise(r=>setTimeout(r,700));
async function terrain(lon,lat){
try{
const r=await g.api.getGuarantiedGroundAltitude([lat,lon,0]);
if(Number.isFinite(r?.[0]?.height))return r[0].height;
}catch(e){}
const h=scene.globe.getHeight(C.Cartographic.fromDegrees(lon,lat));
return Number.isFinite(h)?h:0;
}
function resolveCoordinates(cfg){
if(cfg.localENU){
const origin=C.Cartesian3.fromDegrees(cfg.lon,cfg.lat,0);
const frame=C.Transforms.eastNorthUpToFixedFrame(origin);
const local=new C.Cartesian3(cfg.east||0,cfg.north||0,0);
const horizontal=C.Matrix4.multiplyByPoint(frame,local,new C.Cartesian3());
const carto=C.Cartographic.fromCartesian(horizontal);
return{lon:C.Math.toDegrees(carto.longitude),lat:C.Math.toDegrees(carto.latitude)};
}
let lon=cfg.lon,lat=cfg.lat;
if(cfg.east||cfg.north){
lat+=(cfg.north||0)/110540;
lon+=(cfg.east||0)/(111320*Math.cos(C.Math.toRadians(cfg.lat)));
}
return{lon,lat};
}
function aircraftPosition(){
const a=g.aircraft?.instance?.llaLocation||g.aircraft?.llaLocation;
return a&&Number.isFinite(a[0])&&Number.isFinite(a[1])?{lat:a[0],lon:a[1]}:null;
}
function distance(a,b){
const rad=x=>x*Math.PI/180;
const dLat=rad(b.lat-a.lat),dLon=rad(b.lon-a.lon);
const q=Math.sin(dLat/2)**2+Math.cos(rad(a.lat))*Math.cos(rad(b.lat))*Math.sin(dLon/2)**2;
return 6371000*2*Math.atan2(Math.sqrt(q),Math.sqrt(Math.max(0,1-q)));
}
const states=configs.map(cfg=>({cfg,coords:resolveCoordinates(cfg),model:null,loading:false,retryAt:0}));
let destroyed=false,queueBusy=false;
async function loadOne(s){
s.loading=true;
let model=null;
try{
let pos=aircraftPosition();
if(destroyed||!pos||distance(pos,s.coords)>RADIUS)return;
const ground=s.cfg.sampleTerrain?await terrain(s.coords.lon,s.coords.lat):0;
pos=aircraftPosition();
if(destroyed||!pos||distance(pos,s.coords)>RADIUS)return;
const cfg=s.cfg;
const position=C.Cartesian3.fromDegrees(s.coords.lon,s.coords.lat,ground+cfg.height);
const hpr=new C.HeadingPitchRoll(C.Math.toRadians(cfg.rz),C.Math.toRadians(cfg.rx),C.Math.toRadians(cfg.ry));
const rotation=C.Transforms.headingPitchRollQuaternion(position,hpr);
const modelMatrix=C.Matrix4.fromTranslationQuaternionRotationScale(position,rotation,new C.Cartesian3(cfg.scale,cfg.scale,cfg.scale));
model=await C.Model.fromGltf({url:cfg.url,modelMatrix,scale:1});
pos=aircraftPosition();
if(destroyed||!pos||distance(pos,s.coords)>RADIUS){model.destroy?.();return;}
model.color=new C.Color(cfg.light,cfg.light,cfg.light,1);
if(C.ModelColorBlendMode?.HIGHLIGHT!==undefined){
model.colorBlendMode=C.ModelColorBlendMode.HIGHLIGHT;
model.colorBlendAmount=HIGHLIGHT;
}
model.imageBasedLightingFactor=new C.Cartesian2(cfg.diffuse??1,cfg.specular??REFLECTION);
scene.primitives.add(model);
s.model=model;
model=null;
scene.requestRender();
console.log("[AIRPORT] Loaded:",cfg.name);
}catch(e){
s.retryAt=Date.now()+15000;
if(model&&!model.isDestroyed?.())model.destroy?.();
console.error("[AIRPORT] Failed:",s.cfg.name,e);
}finally{
s.loading=false;
}
}
async function loadNearby(){
if(queueBusy||destroyed)return;
queueBusy=true;
try{
while(!destroyed){
const pos=aircraftPosition();
if(!pos)break;
const next=states.filter(s=>!s.model&&!s.loading&&s.retryAt<=Date.now()&&distance(pos,s.coords)<=RADIUS).sort((a,b)=>distance(pos,a.coords)-distance(pos,b.coords))[0];
if(!next)break;
await loadOne(next);
}
}finally{
queueBusy=false;
}
}
function update(){
const pos=aircraftPosition();
if(!pos||destroyed)return;
for(const s of states){
if(s.model&&distance(pos,s.coords)>RADIUS){
scene.primitives.remove(s.model);
s.model=null;
console.log("[AIRPORT] Unloaded:",s.cfg.name);
scene.requestRender();
}
}
if(!queueBusy)loadNearby();
}
const timer=setInterval(update,1500);
window.__airportModels={
get items(){return states.filter(s=>s.model).map(s=>({name:s.cfg.name,model:s.model,lat:s.coords.lat,lon:s.coords.lon}));},
destroy(){
destroyed=true;
clearInterval(timer);
for(const s of states){
if(s.model){scene.primitives.remove(s.model);s.model=null;}
}
scene.requestRender();
console.log("[AIRPORT] Removed");
}
};
update();
console.log("[AIRPORT] Streaming enabled:",RADIUS/1000+"km");
})().catch(e=>console.error("[AIRPORT SYSTEM ERROR]",e));