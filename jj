{name:"mono",url:KH+"h044_mono.glb",lon:127.642279,lat:26.199309,east:770,north:658,height:2,scale:10,rz:88,rx:0,ry:0,light:2.565,diffuse:2,specular:2,sampleTerrain:true},
{name:"terminal",url:KH+"h044_terminal.glb",lon:127.642279,lat:26.199309,east:748,north:700,height:2,scale:10,rz:88,rx:0,ry:0,light:2.36,diffuse:2,specular:2,sampleTerrain:true},
{name:"yakyu",url:KH+"h044_yakyu.glb",lon:127.642279,lat:26.199309,east:329,north:-1864,height:1.6,scale:112,rz:88,rx:0,ry:0,light:7.47,diffuse:2,specular:2,sampleTerrain:true}
];
window.__airportModels?.destroy?.();
window.geofsNewHDState=true;
if(window.jQuery)jQuery("body").trigger("terrainProviderWillUpdate");
g.geoIpUpdate=function(){
delete g.api.analytics;
document.body.classList.add("geofs-hd");
