function getPosition(s){
const origin=C.Cartesian3.fromDegrees(
BASE_LON,BASE_LAT,0
);

const frame=C.Transforms.eastNorthUpToFixedFrame(origin);

const local=new C.Cartesian3(
s.east,s.north,0
);

const horizontal=C.Matrix4.multiplyByPoint(
frame,local,new C.Cartesian3()
);

const carto=C.Cartographic.fromCartesian(horizontal);

let terrain=scene.globe.getHeight(carto);
if(!Number.isFinite(terrain))terrain=0;

return C.Cartesian3.fromRadians(
carto.longitude,
carto.latitude,
terrain+s.height
);
}

function updateModel(item){
if(!item.model||destroyed)return;

const pos=getPosition(item);

const hpr=new C.HeadingPitchRoll(
C.Math.toRadians(item.rz),
C.Math.toRadians(item.rx),
C.Math.toRadians(item.ry)
);

item.model.modelMatrix=
C.Transforms.headingPitchRollToFixedFrame(
pos,
hpr,
C.Ellipsoid.WGS84,
C.Transforms.eastNorthUpToFixedFrame
);

item.model.scale=item.scale;

item.model.color=new C.Color(
item.light,item.light,item.light,1
);

item.model.imageBasedLightingFactor=
new C.Cartesian2(item.diffuse,item.specular);
}

async function loadItem(item,index){

if(destroyed)return;

console.log(
`[${index+1}/${items.length}] 読み込み: ${item.name}`
);

try{

const model=C.Model.fromGltf({
url:BASE+item.file,
modelMatrix:C.Matrix4.IDENTITY,
scale:item.scale
});

item.model=scene.primitives.add(model);
item.model.show=false;
primitives.push(model);

if(model.readyPromise&&typeof model.readyPromise.then==="function"){
await model.readyPromise;
}

if(destroyed){
scene.primitives.remove(model);
return;
}

updateModel(item);
model.show=true;
item.loaded=true;

console.log("配置完了:",item.name);

}catch(e){

item.error=true;

if(item.model){
scene.primitives.remove(item.model);
item.model=null;
}

console.error("読み込み失敗:",item.name,item.file,e);
}
}

